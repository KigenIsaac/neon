# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Deepgram credential
DEEPGRAM_API_KEY=

# Set to false to disable automatic anonymous Supabase sign-in.
# The current demo experience expects anonymous sessions by default.
NEXT_PUBLIC_ENABLE_ANON_AUTH=true
